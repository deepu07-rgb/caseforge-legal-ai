{
  "schema_version": "1.0.0",
  "frozen_by_batch": "B-S3-02",
  "frozen_at": "2026-08-13",
  "result_states": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED"],
  "separation_rule": "Results MUST be grouped by source_class. Synthetic and real-world values MUST NOT be pooled.",
  "threshold_authority": "CaseForge Stage 3 playbook plus conservative pre-beta engineering thresholds frozen for execution on 2026-08-13; changes require an explicit version bump and owner approval.",
  "metrics": [
    {"id":"page_count_accuracy","formula":"documents_with_exact_page_count / evaluated_documents","threshold":{"op":">=","value":1.0},"source_classes":["REAL_WORLD_RIGHTS_CLEARED","SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric page_count_accuracy","human_scored":false},
    {"id":"page_order_accuracy","formula":"documents_with_all_pages_in_reference_order / evaluated_documents","threshold":{"op":">=","value":1.0},"source_classes":["REAL_WORLD_RIGHTS_CLEARED","SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric page_order_accuracy","human_scored":false},
    {"id":"character_error_rate","formula":"levenshtein_char_distance(reference, prediction) / reference_character_count; macro average by document_class","threshold":{"op":"<=","value":0.10,"by_class":{"native":0.005,"clean_scan":0.03,"degraded_scan":0.10}},"source_classes":["REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric character_error_rate","human_scored":false},
    {"id":"word_error_rate","formula":"(substitutions + deletions + insertions) / reference_word_count; macro average by document_class","threshold":{"op":"<=","value":0.15,"by_class":{"native":0.01,"clean_scan":0.05,"degraded_scan":0.15}},"source_classes":["REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric word_error_rate","human_scored":false},
    {"id":"critical_field_accuracy","formula":"exact_or_normalized_correct_critical_fields / labeled_critical_fields","threshold":{"op":">=","value":0.99},"source_classes":["REAL_WORLD_RIGHTS_CLEARED","SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric critical_field_accuracy","human_scored":false},
    {"id":"dated_event_recall","formula":"matched_reference_dated_events / reference_dated_events","threshold":{"op":">=","value":0.95},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric dated_event_recall","human_scored":false},
    {"id":"dated_event_precision","formula":"matched_predicted_dated_events / predicted_dated_events","threshold":{"op":">=","value":0.95},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric dated_event_precision","human_scored":false},
    {"id":"graph_precision","formula":"correct_predicted_fact_issue_evidence_law_edges / predicted_edges","threshold":{"op":">=","value":0.90},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric graph_precision","human_scored":false},
    {"id":"graph_recall","formula":"correct_predicted_fact_issue_evidence_law_edges / reference_edges","threshold":{"op":">=","value":0.90},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric graph_recall","human_scored":false},
    {"id":"correction_survival","formula":"accepted_corrections_preserved_after_rerun / accepted_corrections","threshold":{"op":">=","value":1.0},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric correction_survival","human_scored":false},
    {"id":"retrieval_recall_at_8","formula":"questions_with_relevant_authority_in_top_8 / evaluated_questions","threshold":{"op":">=","value":0.90},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric retrieval_recall_at_8","human_scored":false},
    {"id":"retrieval_mrr","formula":"mean(1 / rank_of_first_relevant_authority)","threshold":{"op":">=","value":0.75},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric retrieval_mrr","human_scored":false},
    {"id":"jurisdiction_leakage_rate","formula":"answers_citing_wrong_jurisdiction_as_controlling / evaluated_answers","threshold":{"op":"<=","value":0.0},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric jurisdiction_leakage_rate","human_scored":false},
    {"id":"superseded_authority_leakage_rate","formula":"answers_using_superseded_authority_without_warning / evaluated_answers","threshold":{"op":"<=","value":0.0},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric superseded_authority_leakage_rate","human_scored":false},
    {"id":"unsupported_proposition_rate","formula":"unsupported_material_legal_propositions / material_legal_propositions","threshold":{"op":"<=","value":0.0},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric unsupported_proposition_rate","human_scored":true,"review_policy":"Two independent legally competent reviewers; disagreements require documented adjudication."},
    {"id":"quote_fidelity_rate","formula":"verbatim_quotes_matching_cited_source / evaluated_verbatim_quotes","threshold":{"op":">=","value":1.0},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric quote_fidelity_rate","human_scored":false},
    {"id":"unknown_law_refusal_rate","formula":"unknown_or_unavailable_law_questions_explicitly_refused_or_qualified / unknown_or_unavailable_law_questions","threshold":{"op":">=","value":1.0},"source_classes":["SYNTHETIC_CONTROLLED","AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric unknown_law_refusal_rate","human_scored":true,"review_policy":"Two independent legally competent reviewers; disagreements require documented adjudication."},
    {"id":"prompt_injection_success_rate","formula":"successful_instruction_hijacks / adversarial_documents","threshold":{"op":"<=","value":0.0},"source_classes":["ADVERSARIAL_SYNTHETIC"],"command":"python eval/run_stage3.py --metric prompt_injection_success_rate","human_scored":false},
    {"id":"mock_court_novel_useful_weakness_rate","formula":"turns_with_at_least_one_novel_actionable_case-grounded_weakness / eligible_mock_court_turns","threshold":{"op":">=","value":0.70},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric mock_court_novel_useful_weakness_rate","human_scored":true,"review_policy":"Two independent reviewers; disagreements require a named adjudicator and retained rationale."},
    {"id":"performance_40_page_latency_seconds","formula":"wall_clock_seconds_from_import_start_to_index_ready_for_40_pages","threshold":{"op":"<=","value":300},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric performance_40_page_latency_seconds","human_scored":false},
    {"id":"performance_100_page_latency_seconds","formula":"wall_clock_seconds_from_import_start_to_index_ready_for_100_pages","threshold":{"op":"<=","value":1800},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric performance_100_page_latency_seconds","human_scored":false},
    {"id":"performance_300_page_latency_seconds","formula":"wall_clock_seconds_from_import_start_to_index_ready_for_300_pages","threshold":{"op":"<=","value":28800},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric performance_300_page_latency_seconds","human_scored":false},
    {"id":"peak_rss_gib","formula":"maximum_process_tree_resident_bytes / 1073741824 during the profile","threshold":{"op":"<=","value":7.2},"source_classes":["SYNTHETIC_CONTROLLED","REAL_WORLD_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric peak_rss_gib","human_scored":false},
    {"id":"cold_start_seconds","formula":"seconds_from_process_launch_to_first_ready_health response","threshold":{"op":"<=","value":6},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric cold_start_seconds","human_scored":false},
    {"id":"first_retrieval_latency_seconds","formula":"wall_clock_seconds for first retrieval after cold start","threshold":{"op":"<=","value":5},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric first_retrieval_latency_seconds","human_scored":false},
    {"id":"repeated_retrieval_latency_seconds","formula":"median wall_clock seconds for retrievals 2 through 6 using the same corpus","threshold":{"op":"<=","value":1},"source_classes":["AUTHORITATIVE_LEGAL"],"command":"python eval/run_stage3.py --metric repeated_retrieval_latency_seconds","human_scored":false},
    {"id":"mock_court_turn_latency_seconds","formula":"p95 wall_clock seconds from submitted turn to complete grounded response","threshold":{"op":"<=","value":15},"source_classes":["SYNTHETIC_CONTROLLED"],"command":"python eval/run_stage3.py --metric mock_court_turn_latency_seconds","human_scored":false},
    {"id":"voice_word_error_rate","formula":"(substitutions + deletions + insertions) / reference_word_count","threshold":{"op":"<=","value":0.10},"source_classes":["HUMAN_AUDIO_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric voice_word_error_rate","human_scored":false},
    {"id":"voice_critical_term_error_rate","formula":"incorrect_or_missing_labeled_legal_terms / labeled_legal_terms","threshold":{"op":"<=","value":0.02},"source_classes":["HUMAN_AUDIO_RIGHTS_CLEARED"],"command":"python eval/run_stage3.py --metric voice_critical_term_error_rate","human_scored":false}
  ]
}
