{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/akpkg.schema.json",
  "title": "CaseForge .akpkg Manifest v2",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata_version", "pack_id", "pack_kind", "version", "display_name", "content_sha256", "authoritative_content_sha256", "files", "headnotes_stripped", "trust_level", "controlled_beta_eligible", "sources_file", "chunks_file"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "metadata_version": { "const": "2.0.0" },
    "pack_id": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "pack_kind": { "enum": ["official", "custom"] },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "jurisdiction_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "version": { "type": "string", "minLength": 1 }, "display_name": { "type": "string", "minLength": 1 }, "description": { "type": ["string", "null"] },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authoritative_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "role"], "properties": { "path": { "type": "string", "pattern": "^(content|metadata)/[A-Za-z0-9._/-]+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 }, "role": { "enum": ["AUTHORITATIVE_CONTENT", "LEGAL_SOURCES", "LEGAL_CHUNKS", "DERIVED_ARTEFACT"] } } } },
    "headnotes_stripped": { "type": "boolean" },
    "signature_alg": { "const": "Ed25519" }, "signer_key_id": { "type": ["string", "null"] },
    "trust_level": { "enum": ["OFFICIAL_VERIFIED", "CUSTOM"] },
    "controlled_beta_eligible": { "type": "boolean" },
    "sources_file": { "const": "metadata/legal_sources.json" }, "chunks_file": { "const": "metadata/legal_chunks.json" },
    "migration": { "type": ["object", "null"], "additionalProperties": false, "properties": { "from_schema_version": { "type": "string" }, "development_only": { "type": "boolean" }, "notes": { "type": "string" } } }
    ,"publisher": { "type": "string", "minLength": 1 }
    ,"updated_at": { "type": "string", "format": "date" }
    ,"source_status": { "enum": ["CURRENT", "SUPERSEDED", "PARTIALLY_SUPERSEDED", "UNKNOWN"] }
    ,"supersedes_version": { "type": ["string", "null"] }
    ,"superseded_by_version": { "type": ["string", "null"] }
    ,"editorial_review_status": { "type": "string", "minLength": 1 }
    ,"rights_basis": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "pack_kind": { "const": "official" } } }, "then": { "required": ["signature_alg", "signer_key_id"], "properties": { "trust_level": { "const": "OFFICIAL_VERIFIED" }, "controlled_beta_eligible": { "const": true }, "headnotes_stripped": { "const": true } } } },
    { "if": { "properties": { "pack_kind": { "const": "custom" } } }, "then": { "properties": { "trust_level": { "const": "CUSTOM" }, "controlled_beta_eligible": { "const": false } } } }
  ],
  "x-caseforge": {
    "status": "FROZEN_FOR_IMPLEMENTATION", "batch": "B-S3-09", "legacy_policy": "v1 packs may be loaded only as DEVELOPMENT_ONLY and controlled_beta_eligible=false",
    "transport": "extracted directory only; archive transport is not supported and must be rejected until a separate extraction/containment contract is frozen",
    "resource_limits": { "max_files": 4096, "max_file_bytes": 67108864, "max_total_bytes": 536870912, "max_depth": 16 },
    "canonical_hash": "content_sha256 covers every listed content and metadata file; authoritative_content_sha256 covers AUTHORITATIVE_CONTENT files and is the legal chunk pack_checksum. Official signature covers content_sha256.",
    "authoritative_rule": "DERIVED_ARTEFACT files and DERIVED_SUMMARY records cannot carry OFFICIAL_VERIFIED trust or replace exact source text."
  }
}
