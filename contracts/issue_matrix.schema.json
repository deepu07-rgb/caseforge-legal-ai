{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/issue_matrix.schema.json",
  "title": "CaseForge Chambers Issue Matrix",
  "description": "Neutral, record-only side-by-side view of judge-accepted issues (PRD v4.0 §9.2, G7, G8). Never ranks, scores, or favours a party, and never suggests an answer.",
  "schema_version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_id", "case_id", "built_at", "parties", "issues", "neutrality"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "matrix_id": { "type": "string" },
    "case_id": { "type": "string" },
    "built_at": { "type": "string", "format": "date-time" },
    "parties": {
      "type": "array", "minItems": 2,
      "items": { "type": "object", "additionalProperties": false, "required": ["party_id", "display_name", "role"], "properties": { "party_id": { "type": "string" }, "display_name": { "type": "string" }, "role": { "type": "string" } } }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_id", "text", "origin", "template_rule_id", "judge_decision", "merged_into", "positions", "admitted_facts", "disputed_facts", "unanswered_arguments"],
        "properties": {
          "issue_id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "origin": { "enum": ["TEMPLATE", "GRAPH_ISSUE", "JUDGE_AUTHORED"] },
          "template_rule_id": { "type": ["string", "null"] },
          "judge_decision": { "enum": ["PROPOSED", "ACCEPTED", "EDITED", "MERGED", "REJECTED"] },
          "merged_into": { "type": ["string", "null"] },
          "positions": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["party_id", "sentences", "evidence", "authorities"],
              "properties": {
                "party_id": { "type": "string" },
                "sentences": { "type": "array", "items": { "$ref": "#/$defs/Sentence" } },
                "evidence": { "type": "array", "items": { "$ref": "#/$defs/MatterLocator" } },
                "authorities": {
                  "type": "array",
                  "items": { "type": "object", "additionalProperties": false, "required": ["audit_item_id", "result"], "properties": { "audit_item_id": { "type": "string" }, "result": { "enum": ["VERIFIED", "VERIFIED_WITH_NOTE", "MISQUOTED", "NOT_IN_CORPUS", "SUPERSEDED", "NOT_APPLICABLE", "CUSTOM_SOURCE"] } } }
                }
              }
            }
          },
          "admitted_facts": { "type": "array", "items": { "$ref": "#/$defs/FactRef" } },
          "disputed_facts": { "type": "array", "items": { "$ref": "#/$defs/FactRef" } },
          "unanswered_arguments": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["argument_node_id", "by_party_id", "unanswered_by_party_id", "locator"],
              "properties": { "argument_node_id": { "type": "string" }, "by_party_id": { "type": "string" }, "unanswered_by_party_id": { "type": "string" }, "locator": { "$ref": "#/$defs/MatterLocator" } }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "judge_decision": { "enum": ["PROPOSED", "REJECTED", "MERGED"] } } }, "then": { "properties": { "positions": { "maxItems": 0 }, "admitted_facts": { "maxItems": 0 }, "disputed_facts": { "maxItems": 0 }, "unanswered_arguments": { "maxItems": 0 } } } },
          { "if": { "properties": { "judge_decision": { "const": "MERGED" } } }, "then": { "properties": { "merged_into": { "type": "string" } } } }
        ]
      }
    },
    "neutrality": {
      "type": "object", "additionalProperties": false, "required": ["party_scoring", "outcome_suggestion", "record_only"],
      "properties": { "party_scoring": { "const": false }, "outcome_suggestion": { "const": false }, "record_only": { "const": true } }
    }
  },
  "$defs": {
    "MatterLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["doc_id", "page_index", "char_start", "char_end", "excerpt"],
      "properties": {
        "doc_id": { "type": "string" }, "page_index": { "type": ["integer", "null"], "minimum": 0 },
        "char_start": { "type": "integer", "minimum": 0 }, "char_end": { "type": "integer", "minimum": 0 },
        "line_start": { "type": ["integer", "null"], "minimum": 1 }, "line_end": { "type": ["integer", "null"], "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "Sentence": {
      "type": "object", "additionalProperties": false, "required": ["text", "classification", "locators"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["RECORD", "LAW", "INFERENCE_FROM_RECORD"] },
        "locators": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "FactRef": {
      "type": "object", "additionalProperties": false, "required": ["fact_node_id", "locators", "party_ids"],
      "properties": { "fact_node_id": { "type": "string" }, "locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MatterLocator" } }, "party_ids": { "type": "array", "items": { "type": "string" } } }
    }
  },
  "x-caseforge": {
    "status": "FROZEN_FOR_IMPLEMENTATION",
    "batch": "B-S4-01",
    "implemented_by": ["B-S4-18"],
    "prd_refs": ["PRD v4.0 §9.2", "AC-S4-12.1", "AC-S4-12.2", "AC-S4-12.3"],
    "record_only": "EXTRA_RECORD is not a renderable classification (G7).",
    "unanswered_rule": "Deterministic graph query: an argument by one party with no responsive node by the other party."
  }
}
