{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/akpkg_v2_1.schema.json",
  "title": "CaseForge .akpkg Manifest v2.1 (Stage 4)",
  "description": "Additive successor to akpkg.schema.json v2.0.0. Adds RULE_TABLE, TREATMENT_EDGES and DISCLOSURE_TEMPLATES content. v2.0.0 manifests remain valid under akpkg.schema.json and keep installing unchanged; this file never replaces it.",
  "schema_version": "2.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata_version", "pack_id", "pack_kind", "version", "display_name", "content_sha256", "authoritative_content_sha256", "files", "headnotes_stripped", "trust_level", "controlled_beta_eligible", "sources_file", "chunks_file", "currency_date"],
  "properties": {
    "schema_version": { "const": "2.1.0" },
    "metadata_version": { "const": "2.0.0" },
    "pack_id": { "type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "pack_kind": { "enum": ["official", "custom"] },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "jurisdiction_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authoritative_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": { "type": "string", "pattern": "^(content|metadata)/[A-Za-z0-9._/-]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["AUTHORITATIVE_CONTENT", "LEGAL_SOURCES", "LEGAL_CHUNKS", "DERIVED_ARTEFACT", "RULE_TABLE", "TREATMENT_EDGES", "DISCLOSURE_TEMPLATES"] }
        }
      }
    },
    "headnotes_stripped": { "type": "boolean" },
    "signature_alg": { "const": "Ed25519" },
    "signer_key_id": { "type": ["string", "null"] },
    "trust_level": { "enum": ["OFFICIAL_VERIFIED", "CUSTOM"] },
    "controlled_beta_eligible": { "type": "boolean" },
    "sources_file": { "const": "metadata/legal_sources.json" },
    "chunks_file": { "const": "metadata/legal_chunks.json" },
    "rule_tables_files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^metadata/rule_tables/[A-Za-z0-9._-]+\\.json$" } },
    "treatment_edges_file": { "type": ["string", "null"], "pattern": "^metadata/treatment_edges\\.json$" },
    "disclosure_templates_file": { "type": ["string", "null"], "pattern": "^metadata/disclosure_templates\\.json$" },
    "currency_date": { "type": "string", "format": "date", "description": "Date up to which the pack's legal content was checked; shown on every citation (PRD v4.0 §7.8)." },
    "delta": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["base_version", "base_content_sha256"],
      "properties": { "base_version": { "type": "string" }, "base_content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    },
    "migration": { "type": ["object", "null"], "additionalProperties": false, "properties": { "from_schema_version": { "type": "string" }, "development_only": { "type": "boolean" }, "notes": { "type": "string" } } },
    "publisher": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "source_status": { "enum": ["CURRENT", "SUPERSEDED", "PARTIALLY_SUPERSEDED", "UNKNOWN"] },
    "supersedes_version": { "type": ["string", "null"] },
    "superseded_by_version": { "type": ["string", "null"] },
    "editorial_review_status": { "type": "string", "minLength": 1 },
    "rights_basis": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "pack_kind": { "const": "official" } } }, "then": { "required": ["signature_alg", "signer_key_id"], "properties": { "trust_level": { "const": "OFFICIAL_VERIFIED" }, "controlled_beta_eligible": { "const": true }, "headnotes_stripped": { "const": true } } } },
    { "if": { "properties": { "pack_kind": { "const": "custom" } } }, "then": { "properties": { "trust_level": { "const": "CUSTOM" }, "controlled_beta_eligible": { "const": false }, "rule_tables_files": { "maxItems": 0 } } } }
  ],
  "x-caseforge": {
    "status": "FROZEN_FOR_IMPLEMENTATION",
    "batch": "B-S4-01",
    "implemented_by": ["B-S4-03", "B-S4-05", "B-S4-13"],
    "supersedes": null,
    "coexists_with": "akpkg.schema.json v2.0.0 (unchanged)",
    "prd_refs": ["PRD v4.0 §5", "§7.1", "§7.8", "§11"],
    "inherits": "All B-S3-09 transport, resource-limit, canonical-hash and authoritative rules of akpkg v2.0.0 apply unchanged.",
    "file_rules": [
      "Each rule_tables_files entry must appear in files[] with role RULE_TABLE and validate against rule_table.schema.json.",
      "treatment_edges_file must appear with role TREATMENT_EDGES; every element validates against treatment_edge.schema.json.",
      "disclosure_templates_file must appear with role DISCLOSURE_TEMPLATES; every element validates against disclosure_template.schema.json.",
      "TREATMENT_EDGES are derived content and cannot carry OFFICIAL_VERIFIED trust for the edges themselves; they reference verified citing text.",
      "Custom packs may not carry RULE_TABLE files (custom data can never become a signed rule)."
    ],
    "delta_rule": "A delta manifest names its base; install fails closed if the installed base content_sha256 differs."
  }
}
