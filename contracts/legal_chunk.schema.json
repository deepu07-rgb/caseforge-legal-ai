{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/legal_chunk.schema.json",
  "title": "CaseForge Legal Chunk",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "chunk_id", "source_id", "pack_id", "title", "jurisdiction", "jurisdiction_path", "authority_type", "issuing_authority", "citation", "section", "effective_from", "effective_to", "version", "source_file", "page", "paragraph", "heading_path", "exact_text", "checksum", "source_checksum", "pack_checksum", "trust_level", "superseded_status", "publisher", "source_reference", "content_kind", "temporal_status"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "chunk_id": { "type": "string", "pattern": "^cfchunk:[a-z0-9][a-z0-9._-]+:[a-f0-9]{16,64}$" },
    "source_id": { "type": "string", "pattern": "^cfsrc:[a-z0-9][a-z0-9._-]+:[a-f0-9]{16,64}$" },
    "pack_id": { "type": "string" }, "title": { "type": "string" }, "jurisdiction": { "type": "string" },
    "jurisdiction_path": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authority_type": { "enum": ["CONSTITUTION", "STATUTE", "REGULATION", "RULE", "JUDGMENT", "TREATY", "OFFICIAL_GUIDANCE", "SECONDARY", "CUSTOM", "UNKNOWN"] },
    "issuing_authority": { "type": "string" }, "citation": { "type": "string" }, "section": { "type": "string" },
    "effective_from": { "anyOf": [{ "type": "string", "format": "date" }, { "const": "UNKNOWN" }] },
    "effective_to": { "anyOf": [{ "type": "string", "format": "date" }, { "const": "UNKNOWN" }] },
    "version": { "type": "string" }, "amendment": { "type": "string" }, "source_file": { "type": "string", "pattern": "^content/" },
    "page": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "UNKNOWN" }] }, "paragraph": { "type": "string" },
    "heading_path": { "type": "array", "items": { "type": "string" } }, "exact_text": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "source_checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pack_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trust_level": { "enum": ["OFFICIAL_VERIFIED", "OFFICIAL_UNVERIFIED", "CUSTOM", "DEVELOPMENT_ONLY"] },
    "superseded_status": { "enum": ["CURRENT", "SUPERSEDED", "PARTIALLY_SUPERSEDED", "UNKNOWN"] },
    "publisher": { "type": "string" }, "source_reference": { "type": "string" },
    "content_kind": { "enum": ["AUTHORITATIVE_TEXT", "DERIVED_SUMMARY"] }, "derived_from_source_id": { "type": ["string", "null"] },
    "temporal_status": { "enum": ["APPLICABLE", "NOT_YET_EFFECTIVE", "EXPIRED", "UNKNOWN"] },
    "court": { "type": "string" }, "case_name": { "type": "string" }, "case_number": { "type": "string" },
    "decision_date": { "anyOf": [{ "type": "string", "format": "date" }, { "const": "UNKNOWN" }] }, "paragraph_number": { "type": "string" },
    "holding_tags": { "type": "array", "items": { "type": "string" } }, "proposition_tags": { "type": "array", "items": { "type": "string" } },
    "precedential_status": { "enum": ["BINDING", "PERSUASIVE", "NON_PRECEDENTIAL", "OVERRULED", "UNKNOWN"] }
  },
  "allOf": [
    { "if": { "properties": { "content_kind": { "const": "DERIVED_SUMMARY" } } }, "then": { "required": ["derived_from_source_id"], "properties": { "trust_level": { "not": { "const": "OFFICIAL_VERIFIED" } } } } },
    { "if": { "properties": { "authority_type": { "const": "JUDGMENT" } } }, "then": { "required": ["court", "case_name", "case_number", "decision_date", "paragraph_number", "holding_tags", "proposition_tags", "precedential_status"] } }
  ],
  "x-caseforge": { "status": "FROZEN_FOR_IMPLEMENTATION", "batch": "B-S3-08", "exactness": "checksum must equal sha256 of UTF-8 exact_text; source_checksum and pack_checksum must verify", "stable_id": "cfchunk:<pack_id>:<first16 sha256(source_id+'|'+chunk_checksum)>; duplicate chunk IDs are rejected", "unknown_policy": "UNKNOWN temporal, authority, trust, or supersession metadata is non-controlling and must not be promoted to GREEN." }
}
