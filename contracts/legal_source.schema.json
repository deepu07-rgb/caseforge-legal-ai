{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/legal_source.schema.json",
  "title": "CaseForge Legal Source",
  "schema_version": "2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "title", "jurisdiction", "jurisdiction_path", "authority_type", "issuing_authority", "citation", "section", "effective_from", "effective_to", "version", "amendment", "source_file", "page", "paragraph", "heading_path", "exact_text", "checksum", "pack_id", "trust_level", "superseded_status", "publisher", "source_reference", "content_kind"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "source_id": { "type": "string", "pattern": "^cfsrc:[a-z0-9][a-z0-9._-]+:[a-f0-9]{16,64}$" },
    "title": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "jurisdiction_path": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authority_type": { "$ref": "#/$defs/authorityType" },
    "issuing_authority": { "type": "string", "minLength": 1 },
    "citation": { "type": "string", "minLength": 1 },
    "section": { "type": "string", "minLength": 1, "description": "Section, rule, article, or UNKNOWN." },
    "effective_from": { "$ref": "#/$defs/dateOrUnknown" },
    "effective_to": { "$ref": "#/$defs/dateOrUnknown" },
    "version": { "type": "string", "minLength": 1 },
    "amendment": { "type": "string", "default": "UNKNOWN" },
    "source_file": { "type": "string", "pattern": "^content/[A-Za-z0-9._/-]+$" },
    "page": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "UNKNOWN" }] },
    "paragraph": { "type": "string", "default": "UNKNOWN" },
    "heading_path": { "type": "array", "items": { "type": "string" } },
    "exact_text": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "trust_level": { "$ref": "#/$defs/trustLevel" },
    "superseded_status": { "$ref": "#/$defs/supersededStatus" },
    "publisher": { "type": "string", "minLength": 1 },
    "source_reference": { "type": "string", "minLength": 1 },
    "content_kind": { "enum": ["AUTHORITATIVE_TEXT", "DERIVED_SUMMARY"] },
    "derived_from_source_id": { "type": ["string", "null"] },
    "court": { "type": "string" },
    "case_name": { "type": "string" },
    "case_number": { "type": "string" },
    "decision_date": { "$ref": "#/$defs/dateOrUnknown" },
    "paragraph_number": { "type": "string" },
    "holding_tags": { "type": "array", "items": { "type": "string" } },
    "proposition_tags": { "type": "array", "items": { "type": "string" } },
    "precedential_status": { "enum": ["BINDING", "PERSUASIVE", "NON_PRECEDENTIAL", "OVERRULED", "UNKNOWN"] }
  },
  "$defs": {
    "dateOrUnknown": { "anyOf": [{ "type": "string", "format": "date" }, { "const": "UNKNOWN" }] },
    "authorityType": { "enum": ["CONSTITUTION", "STATUTE", "REGULATION", "RULE", "JUDGMENT", "TREATY", "OFFICIAL_GUIDANCE", "SECONDARY", "CUSTOM", "UNKNOWN"] },
    "trustLevel": { "enum": ["OFFICIAL_VERIFIED", "OFFICIAL_UNVERIFIED", "CUSTOM", "DEVELOPMENT_ONLY"] },
    "supersededStatus": { "enum": ["CURRENT", "SUPERSEDED", "PARTIALLY_SUPERSEDED", "UNKNOWN"] }
  },
  "allOf": [
    { "if": { "properties": { "content_kind": { "const": "DERIVED_SUMMARY" } } }, "then": { "required": ["derived_from_source_id"], "properties": { "trust_level": { "not": { "const": "OFFICIAL_VERIFIED" } } } } },
    { "if": { "properties": { "authority_type": { "const": "JUDGMENT" } } }, "then": { "required": ["court", "case_name", "case_number", "decision_date", "paragraph_number", "holding_tags", "proposition_tags", "precedential_status"] } }
  ],
  "x-caseforge": { "status": "FROZEN_FOR_IMPLEMENTATION", "batch": "B-S3-08", "unknown_policy": "UNKNOWN is never current, applicable, verified, binding, or controlling.", "checksum": "sha256 over UTF-8 exact_text bytes", "stable_id": "cfsrc:<pack_id>:<first 16+ hex of source checksum>" }
}
