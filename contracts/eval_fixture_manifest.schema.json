{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/eval_fixture_manifest.schema.json",
  "title": "CaseForge Stage 3 evaluation fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_id", "suite_id", "status", "source_class",
    "jurisdiction", "purposes", "source", "rights", "assets",
    "expected_answer", "characteristics", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "fixture_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "suite_id": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"},
    "status": {
      "enum": ["DRAFT", "SOURCE_IDENTIFIED", "READY_FOR_REVIEW", "GOLDEN", "BLOCKED"]
    },
    "source_class": {
      "enum": [
        "SYNTHETIC_CONTROLLED", "REAL_WORLD_RIGHTS_CLEARED",
        "AUTHORITATIVE_LEGAL", "ADVERSARIAL_SYNTHETIC",
        "HUMAN_AUDIO_RIGHTS_CLEARED"
      ]
    },
    "jurisdiction": {"enum": ["India", "United States", "Jurisdiction-neutral", "Other"]},
    "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "publisher", "source_url", "acquired_at"],
      "properties": {
        "title": {"type": "string", "minLength": 2},
        "publisher": {"type": "string", "minLength": 2},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "acquired_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "basis", "confidential", "distribution_scope", "may_redistribute"],
      "properties": {
        "status": {"enum": ["VERIFIED", "PENDING", "NOT_APPLICABLE"]},
        "basis": {"type": "string", "minLength": 3},
        "confidential": {"type": "boolean"},
        "distribution_scope": {"enum": ["internal_only", "redistributable", "not_applicable"]},
        "may_redistribute": {"type": "boolean"}
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "bytes", "role", "derived_from"],
        "properties": {
          "path": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"},
          "media_type": {"type": "string", "minLength": 3},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": ["integer", "null"], "minimum": 0},
          "role": {"type": "string", "minLength": 2},
          "derived_from": {"type": ["string", "null"]}
        }
      }
    },
    "expected_answer": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "authored_by", "status", "reviewed_by", "adjudicator"],
      "properties": {
        "path": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|.*\\.\\.).+"},
        "authored_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "status": {"enum": ["NOT_AUTHORED", "DRAFT", "DUAL_REVIEWED", "ADJUDICATED"]},
        "reviewed_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "adjudicator": {"type": ["string", "null"], "minLength": 2}
      }
    },
    "characteristics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "GOLDEN"}}},
      "then": {
        "properties": {
          "rights": {"properties": {"status": {"const": "VERIFIED"}}},
          "assets": {"minItems": 1, "items": {"properties": {"path": {"type": "string"}, "sha256": {"type": "string"}, "bytes": {"type": "integer"}}}},
          "expected_answer": {
            "properties": {
              "path": {"type": "string"},
              "authored_by": {"minItems": 1},
              "status": {"enum": ["DUAL_REVIEWED", "ADJUDICATED"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"source_class": {"enum": ["REAL_WORLD_RIGHTS_CLEARED", "AUTHORITATIVE_LEGAL", "HUMAN_AUDIO_RIGHTS_CLEARED"]}}},
      "then": {"properties": {"rights": {"properties": {"status": {"enum": ["VERIFIED", "PENDING"]}}}}}
    },
    {
      "if": {"properties": {"expected_answer": {"properties": {"status": {"const": "DUAL_REVIEWED"}}}}},
      "then": {"properties": {"expected_answer": {"properties": {"reviewed_by": {"minItems": 2}}}}}
    },
    {
      "if": {"properties": {"expected_answer": {"properties": {"status": {"const": "ADJUDICATED"}}}}},
      "then": {"properties": {"expected_answer": {"properties": {"adjudicator": {"type": "string"}}}}}
    }
  ],
  "x-caseforge": {"frozen_by_batch": "B-S3-02", "frozen_at": "2026-08-13"}
}
