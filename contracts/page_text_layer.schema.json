{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caseforge.local/contracts/page_text_layer.schema.json",
  "title": "PageTextLayer",
  "description": "Per-page native/OCR text layer with raw and calibrated word confidence, critical fields, and normalized geometry (PRD §6.2). B-S3-05.",
  "schema_version": "0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "page_index",
    "recognizer_id",
    "recognized_at_unix_ms",
    "full_text",
    "mean_confidence",
    "page_quality_warn",
    "words",
    "critical_fields"
  ],
  "properties": {
    "doc_id": { "type": "string", "minLength": 1 },
    "page_index": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based page index within the document."
    },
    "recognizer_id": {
      "type": "string",
      "minLength": 1,
      "description": "Frozen native extractor or offline OCR implementation id."
    },
    "recognized_at_unix_ms": { "type": "integer" },
    "full_text": {
      "type": "string",
      "description": "Concatenated page text used for char spans."
    },
    "mean_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Mean of word confidences in [0,1]; 0 if no words."
    },
    "page_quality_warn": {
      "type": "boolean",
      "description": "true when mean_confidence < page_mean_warn_below from constants."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "For B-S3-04, compact JSON diagnostics: state, provenance hashes, preprocessing, duration, review and automatic-extraction gates."
    },
    "calibration_id": {"type": ["string", "null"]},
    "critical_fields": {
      "type": "array",
      "items": {"$ref": "#/$defs/CriticalField"}
    },
    "words": {
      "type": "array",
      "items": { "$ref": "#/$defs/WordSpan" }
    }
  },
  "$defs": {
    "WordSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_index",
        "text",
        "confidence",
        "raw_engine_confidence",
        "calibrated_confidence",
        "confidence_state",
        "char_start",
        "char_end",
        "low_confidence",
        "force_review",
        "suppress_from_auto"
      ],
      "properties": {
        "word_index": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Word confidence in [0,1] (Q-CONST-01 scale A)."
        },
        "raw_engine_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "calibrated_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_state": {"enum": ["calibrated", "raw_only", "missing", "counsel_confirmed"]},
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode codepoint start offset into full_text (inclusive)."
        },
        "char_end": {
          "type": "integer",
          "minimum": 0,
          "description": "Unicode codepoint end offset into full_text (exclusive)."
        },
        "low_confidence": {
          "type": "boolean",
          "description": "confidence < word_highlight_below"
        },
        "force_review": {
          "type": "boolean",
          "description": "confidence < word_force_review_below (or missing conf)"
        },
        "suppress_from_auto": {
          "type": "boolean",
          "description": "confidence < word_suppress_below — keep in layer, skip auto-skeleton"
        },
        "bbox": {
          "type": ["object", "null"],
          "description": "Page bbox {x,y,w,h} normalized 0–1 on the deterministic processed OCR surface; native words may be null when exact glyph geometry is unavailable.",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        }
      }
    },
    "CriticalField": {
      "type": "object",
      "required": ["field_index", "field_type", "text", "char_start", "char_end", "confidence_state", "validation_reasons", "force_review", "suppress_from_auto", "counsel_confirmed", "validator_id"],
      "properties": {
        "field_index": {"type": "integer", "minimum": 0},
        "field_type": {"enum": ["name", "date", "money", "citation", "provision", "case_number", "exhibit_label"]},
        "text": {"type": "string"},
        "char_start": {"type": "integer", "minimum": 0},
        "char_end": {"type": "integer", "minimum": 0},
        "bbox": {"type": ["object", "null"]},
        "raw_engine_confidence": {"type": ["number", "null"]},
        "calibrated_confidence": {"type": ["number", "null"]},
        "field_confidence": {"type": ["number", "null"]},
        "confidence_state": {"enum": ["calibrated", "raw_only", "missing", "counsel_confirmed"]},
        "syntactically_valid": {"type": "boolean"},
        "validation_reasons": {"type": "array", "items": {"type": "string"}},
        "force_review": {"type": "boolean"},
        "suppress_from_auto": {"type": "boolean"},
        "counsel_confirmed": {"type": "boolean"},
        "validator_id": {"type": "string"}
      }
    }
  },
  "x-caseforge": {
    "status": "FROZEN",
    "batch": "B-S3-05",
    "prd_refs": ["§6.2", "AC-6.4"],
    "thresholds_from": "contracts/constants.json → confidence_thresholds.values",
    "out_of_scope": ["case_graph", "parties_nlp", "chronology_nlp"]
  }
}
